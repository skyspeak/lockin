{
  "expo": {
    "name": "Lock In",
    "slug": "lockin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clarity",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff3e6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.skyspeak.lockin",
      "buildNumber": "32",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Lock In uses the microphone so you can dictate thoughts hands-free.",
        "NSCameraUsageDescription": "Lock In uses the camera to attach photos to thoughts.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "itms-beta",
          "itms-apps"
        ],
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.skyspeak.lockin",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#fff3e6"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://lockin.app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Lock In uses the microphone so you can capture thoughts by voice."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ff5a7a"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff3e6",
          "image": "./assets/images/splash.png",
          "imageWidth": 260
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "a62a259b-227d-4878-aa8d-b18d585c06df"
      }
    },
    "owner": "skyspeak"
  }
}
